<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    nuget.org carries the Crestron.SimplSharp.SDK.* packages and the ModelContextProtocol.* packages
    used by the prerequisite checks, so no separate Crestron feed is required for this solution.
    If your organisation's build environment already redirects nuget.org through an internal proxy,
    that redirect is honoured automatically and this file does not need to change.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CrestronAgentLib.SimplSharpPro (MCP Gateway client, Lab 4) is not on a public feed yet: a copy is kept in packages/. -->
    <add key="local" value="./packages" />
  </packageSources>

  <!--
    The MCP SDK packages are pinned to an exact prerelease version in each .csproj (see
    Prerequisites.Mcp.Tests), so restore fetches that version directly; no extra config is needed
    to opt in to prerelease packages.
  -->

</configuration>
